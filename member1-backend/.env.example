# ==============================================================================
# SafeSlope-NER Backend Environment Configuration Template
# ==============================================================================

# ─── 1. Deployment Profile ─────────────────────────────────────────────────────
# Options: 'laptop-workstation-cpu' | 'cloud-production-gpu'
RUNTIME_PROFILE=laptop-workstation-cpu

# ─── 2. Database & Cache ───────────────────────────────────────────────────────
# Supabase connection pooler example:
# DATABASE_URL=postgresql://postgres.fsfoevxbkyhloxdyvzvl:YOUR_SUPABASE_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://resiliner_user:resiliner_pass@localhost:5432/resiliner
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXMEM_MB=2048

# ─── 3. Core Security & Authentication ─────────────────────────────────────────
SERVICE_API_KEY=change-this-shared-key
JWT_SECRET=change-this-jwt-secret-too
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=43200

# OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# Gateway HMAC & Magistrate PIN
GATEWAY_HMAC_SECRET=change-this-gateway-hmac-secret
DM_PIN_BCRYPT_ROUNDS=12

# ─── 4. Live Hardware Ngrok Bridge (Member-2) ──────────────────────────────────
HARDWARE_BRIDGE_URL=https://unknown-remold-lavish.ngrok-free.dev
HARDWARE_BRIDGE_ENABLED=true
HARDWARE_POLL_INTERVAL_SECONDS=5.0

# ─── 5. Local LLM / RAG Engine ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001
LLM_MODEL_NAME=llama3.2:3b
LLM_TIMEOUT_SECONDS=120
RAG_TOP_K_CHUNKS=5
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ==============================================================================
# SATELLITE EARTH OBSERVATION & REMOTE SENSING APIS
# Section 2.2 & 6.1 (Sentinel-1 SAR, Sentinel-2 Optical, InSAR, DEMs)
# ==============================================================================

# ─── 6. Google Earth Engine (GEE) [RECOMMENDED] ────────────────────────────────
# Used for: Cloud computation of Sentinel-1 SAR (VV/VH backscatter), Sentinel-2
#           (NDVI, NDMI, toe-cut masks), and SRTM/NASADEM without downloading rasters.
# How to get:
#   1. Create a project on Google Cloud Console: https://console.cloud.google.com/
#   2. Enable Earth Engine API: https://console.cloud.google.com/apis/library/earthengine.googleapis.com
#   3. Create a Service Account -> Create JSON Key -> Save to credentials/gee-key.json
GEE_SERVICE_ACCOUNT=safeslope-gee@your-gcp-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=credentials/gee-key.json
GEE_PROJECT_ID=your-gcp-project-id

# ─── 7. Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub ──────────────────
# Used for: Direct access to ESA Sentinel-1 (SLC for InSAR, GRD), Sentinel-2 Level-2A,
#           and Copernicus DEM GLO-30.
# How to get:
#   - Register free account at: https://dataspace.copernicus.eu/
#   - Generate OAuth2 Client ID and Secret under User Settings -> OData / API Keys.
CDSE_CLIENT_ID=your-cdse-client-id
CDSE_CLIENT_SECRET=your-cdse-client-secret

# Sentinel Hub (Sinergise / Planet) alternative:
# Register at: https://apps.sentinel-hub.com/dashboard/
SENTINEL_HUB_CLIENT_ID=your-sentinel-hub-client-id
SENTINEL_HUB_CLIENT_SECRET=your-sentinel-hub-client-secret
SENTINEL_HUB_INSTANCE_ID=your-sentinel-hub-instance-id

# ─── 8. NASA Earthdata & Alaska Satellite Facility (ASF DAAC) ──────────────────
# Used for: Sentinel-1 SLC granules for MintPy InSAR processing, NISAR dual-band
#           (L/S-band), and NASA-JAXA GPM IMERG 30-minute rainfall data.
# How to get:
#   - Register free account at: https://urs.earthdata.nasa.gov/
#   - Authorize "Alaska Satellite Facility (ASF)" in Applications.
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password
EARTHDATA_BEARER_TOKEN=your_earthdata_token_optional

# ─── 9. ISRO MOSDAC & Bhuvan (National Remote Sensing Feeds) ───────────────────
# Used for: INSAT-3D/3DR meteorological products (HEM rainfall, TIR thermal)
#           and Cartosat 10m DEM (CartoDEM) for North-East corridor slope geometry.
# How to get:
#   - Register at MOSDAC: https://mosdac.gov.in/
#   - Register at Bhuvan: https://bhuvan.nrsc.gov.in/
MOSDAC_USER_EMAIL=your-email@domain.com
MOSDAC_API_TOKEN=your-mosdac-api-token
BHUVAN_API_TOKEN=your-bhuvan-open-data-token

# ─── 10. Planet Labs (High-Resolution 3m PlanetScope & 50cm SkySat) ─────────────
# Used for: Sub-weekly rapid optical scans to detect illegal excavation / toe cutting
#           and post-landslide golden hour debris thickness mapping.
# How to get:
#   - Sign up at: https://account.planet.com/
PLANET_API_KEY=your-planet-api-key

# ─── 11. OpenTopography (Global DEM Subsetting) ─────────────────────────────────
# Used for: Automated bounding box download of Copernicus 30m / ALOS AW3D30 / SRTM DEMs.
# How to get:
#   - Request free API key at: https://opentopography.org/developers
OPENTOPOGRAPHY_API_KEY=your-opentopography-api-key

# ─── 12. External Weather & Seismic Government APIs (Section 4.3) ──────────────
IMD_API_BASE=https://api.imd.gov.in/rainfall
MOSDAC_API_BASE=https://mosdac.gov.in/api
NCS_API_BASE=https://seismo.gov.in/api/recent
ECMWF_BACKUP_API=https://api.open-meteo.com/v1
